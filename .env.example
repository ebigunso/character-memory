VECTOR_STORE_MODE="embedded"
VECTOR_STORE_PATH="./data/vectors"
# Used only when VECTOR_STORE_MODE="service".
QDRANT_CONNECTION_STRING="http://127.0.0.1:6334"
OXIGRAPH_PATH="./data/oxigraph"
# Embedded persistent Oxigraph is the application default. Set GRAPH_STORE_MODE="in_memory"
# for ephemeral runs; OXIGRAPH_PATH is then unused and may be omitted.
GRAPH_STORE_MODE="persistent"
# Required only by CharacterMemory::new (OpenAI). With new_with_embedding_provider,
# omit both keys; EmbeddingProvider::vector_size supplies the dimension.
OPENAI_API_KEY="YOUR_OPENAI_KEY"
EMBEDDING_MODEL="text-embedding-3-small"
# SQLite is the default, with ./data/retrieval-stats.sqlite3 as its default path.
# In-memory statistics do not use a path or create a statistics file.
# RETRIEVAL_STATS_STORE_MODE="in_memory"
